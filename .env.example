POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DEV_DB_PORT=
DEV_API_PORT=
DEV_WEB_PORT=
PROD_WEB_PORT=
JWT_SECRET=
JWT_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=
# Identifiant client OAuth « Application Web » (console Google Cloud) ; vide = bouton Google masqué.
GOOGLE_CLIENT_ID=
APP_STORAGE_PHOTOS_DIR=
APP_MAX_PHOTO_SIZE=
APP_EVENT_CREATION_LIMIT_24H=
APP_PUBLICATION_CREATION_LIMIT_24H=

# Premier compte d'administration, créé au démarrage si la base n'en a aucun.
APP_PREMIER_ADMIN_EMAIL=
APP_PREMIER_ADMIN_PASSWORD=

# Import de CV par IA. Changer de fournisseur ou de modèle ne demande que ces variables.
# CV_IA_FOURNISSEUR : anthropic | openai (toute API compatible : OpenAI, Mistral, Gemini, OpenRouter, Ollama…)
#                     | demo (profil fictif, sans IA) | vide (import désactivé)
# Exemples :
#   Claude  : CV_IA_FOURNISSEUR=anthropic  CV_IA_MODELE=claude-opus-5-5
#   Gemini     : CV_IA_FOURNISSEUR=openai  CV_IA_URL=https://generativelanguage.googleapis.com/v1beta/openai  CV_IA_MODELE=gemini-3.5-flash-lite
#   Mistral    : CV_IA_FOURNISSEUR=openai  CV_IA_URL=https://api.mistral.ai/v1         CV_IA_MODELE=mistral-large-latest
#   OpenRouter : CV_IA_FOURNISSEUR=openai  CV_IA_URL=https://openrouter.ai/api/v1      CV_IA_MODELE=<identifiant du modèle>
#   Groq       : CV_IA_FOURNISSEUR=openai  CV_IA_URL=https://api.groq.com/openai/v1    CV_IA_MODELE=<identifiant du modèle>
#   Ollama     : CV_IA_FOURNISSEUR=openai  CV_IA_URL=http://host.docker.internal:11434/v1  CV_IA_MODELE=qwen2.5vl
#                (Ollama installé sur le PC ; depuis un conteneur « ollama » : http://ollama:11434/v1)
# CV_IA_URL est l'adresse de base complète : la version (/v1, /v1beta/openai…) en fait partie,
# seul « /chat/completions » est ajouté. Vide : https://api.openai.com/v1.
# CV_IA_IMAGES=false si le modèle ne lit pas les images (seuls les PDF texte et les fichiers Word sont alors acceptés).
CV_IA_FOURNISSEUR=
CV_IA_MODELE=
CV_IA_CLE=
CV_IA_URL=
CV_IA_IMAGES=
CV_IA_NOM_FOURNISSEUR=

# Licence PrimeNG, injectée dans le frontend à la compilation. Sans elle, PrimeNG affiche une bannière.
PRIMENG_LICENSE=
