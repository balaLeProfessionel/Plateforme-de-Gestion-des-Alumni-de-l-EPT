POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DEV_DB_PORT=
DEV_API_PORT=
DEV_WEB_PORT=
PROD_WEB_PORT=
JWT_SECRET=
JWT_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=
APP_STORAGE_PHOTOS_DIR=
APP_MAX_PHOTO_SIZE=
APP_EVENT_CREATION_LIMIT_24H=
APP_PUBLICATION_CREATION_LIMIT_24H=

# Premier compte d'administration, créé au démarrage si la base n'en a aucun.
APP_PREMIER_ADMIN_EMAIL=
APP_PREMIER_ADMIN_PASSWORD=

# Import de CV par IA. Changer de fournisseur ou de modèle ne demande que ces variables.
# CV_IA_FOURNISSEUR : anthropic | openai (toute API compatible : OpenAI, Mistral, Gemini, OpenRouter, Ollama…)
#                     | demo (profil fictif, sans IA) | vide (import désactivé)
# Exemples :
#   Claude  : CV_IA_FOURNISSEUR=anthropic  CV_IA_MODELE=claude-opus-5-5
#   Mistral : CV_IA_FOURNISSEUR=openai     CV_IA_URL=https://api.mistral.ai  CV_IA_MODELE=mistral-large-latest
#   Ollama  : CV_IA_FOURNISSEUR=openai     CV_IA_URL=http://ollama:11434     CV_IA_MODELE=qwen2.5vl
# CV_IA_IMAGES=false si le modèle ne lit pas les images (seuls les PDF texte et les fichiers Word sont alors acceptés).
CV_IA_FOURNISSEUR=
CV_IA_MODELE=
CV_IA_CLE=
CV_IA_URL=
CV_IA_IMAGES=
CV_IA_NOM_FOURNISSEUR=

# Licence PrimeNG, injectée dans le frontend à la compilation. Sans elle, PrimeNG affiche une bannière.
PRIMENG_LICENSE=
